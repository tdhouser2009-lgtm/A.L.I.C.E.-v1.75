@worker = http://localhost:8081

### Health
GET {{worker}}/health

### Inference using a fresh random model
POST {{worker}}/internal/v1/inference
Content-Type: application/json

{
  "prompt": "Hello from the model worker",
  "checkpointId": null
}

### Start a training run
POST {{worker}}/internal/v1/training-runs
Content-Type: application/json

{
  "runId": "debug-run-001",
  "corpusId": "debug-corpus",
  "maxSteps": 100,
  "batchSize": 4
}

### Training run state
GET {{worker}}/internal/v1/training-runs/debug-run-001

### Start an evaluation
POST {{worker}}/internal/v1/evaluations
Content-Type: application/json

{
  "evaluationId": "debug-evaluation-001",
  "checkpointId": "debug-checkpoint",
  "datasetId": "debug-dataset"
}

### Evaluation state
GET {{worker}}/internal/v1/evaluations/debug-evaluation-001
